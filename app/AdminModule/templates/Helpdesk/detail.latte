{block #titles}Helpdesk{/block}
{block content}

<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/admin/">Admin</a></li>
    <li class="breadcrumb-item"><a href="/admin/settings/">Helpdesk</a></li>
    <li class="breadcrumb-item active">E-maily</li>
</ol>

<div class="container-fluid">
    <div class="animated fadeIn">
        <div class="row">
            <div class="col-lg-3">
                <div class="card">
                    <div class="card-header">
                        {$message->email} <form action="{link delete!, identifier => $message->id}" method="post" style="display: inline;" onsubmit="return confirm('Opravdu smazat?')">
                            <input type="hidden" name="_csrf" value="{$presenter->getMutationToken()}">
                            <button type="submit" class="btn btn-danger btn-sm pull-right">Smazat</button>
                        </form>

                    </div>
                    <div class="card-block">
                        <table class="table table-striped">
                            <tr>
                                <td class="col-xs-3">Datum</td>
                                <td>{$message->date_created|date:'j. n. Y H:i'}</td>
                            </tr>
                            <tr>
                                <td>E-mail</td>
                                <td>{$message->email}</td>
                            </tr>
                            <tr>
                                <td>IP adresa</td>
                                <td>{$message->ipaddress}</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="card">
                    <div class="card-header">E-mail</div>
                    <div class="card-block">
                        <div style="width: 100%; height: 500px;" frameborder="0">
                            {$message->message|noescape}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
