{block #titles}Menu{/block}
{block content}

<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
    <li class="breadcrumb-item active"><a href="/admin/menu">Menu</a></li>
    <li class="breadcrumb-item active"><a href="/admin/menu/detail/{$presenter->getParameter('id')}">Detail</a></li>
</ol>

<div class="container-fluid">
    <div class="card">
        <div class="card-block">
            <h2>Obrázky</h2>

            <p>Pro obrázky používejte formát PNG.</p>

            {control menuUpdateImages}

            <div class="row">
                <div class="col-md-3">
                    {if file_exists($basePath.'images/menu/' . $presenter->getParameter('id') . '.png')}
                        <p><img src="{$baseUri}/images/menu/{$presenter->getParameter('id')}.png?{rand(0,400)}" class="img-responsive"></p>
                        <div><form action="{link deleteImage!, identifier => $presenter->getParameter('id')}" method="post" style="display: inline;">
                            <input type="hidden" name="_csrf" value="{$presenter->getMutationToken()}">
                            <button type="submit" class="btn btn-danger btn-xs">Smazat</button>
                        </form></div>
                    {/if}
                </div>
                <div class="col-md-3">
                    {if file_exists($basePath.'images/menu/' . $presenter->getParameter('id') . '_h.png')}
                        <p><img src="{$baseUri}/images/menu/{$presenter->getParameter('id')}_h.png?{rand(0,400)}"
                                class="img-responsive"></p>
                        <div><form action="{link deleteImage!, identifier => $presenter->getParameter('id'), type => '_h'}" method="post" style="display: inline;">
                            <input type="hidden" name="_csrf" value="{$presenter->getMutationToken()}">
                            <button type="submit" class="btn btn-danger btn-xs">Smazat</button>
                        </form></div>
                    {/if}
                </div>
                <div class="col-md-3">
                    {if file_exists($basePath.'images/menu/' . $presenter->getParameter('id') . '_a.png')}
                        <p><img src="{$baseUri}/images/menu/{$presenter->getParameter('id')}_a.png?{rand(0,400)}"
                                class="img-responsive"></p>
                        <div><form action="{link deleteImage!, identifier => $presenter->getParameter('id'), type => '_a'}" method="post" style="display: inline;">
                            <input type="hidden" name="_csrf" value="{$presenter->getMutationToken()}">
                            <button type="submit" class="btn btn-danger btn-xs">Smazat</button>
                        </form></div>
                    {/if}
                </div>
                <div class="col-md-3">
                    {if file_exists($basePath.'images/menu/' . $presenter->getParameter('id') . '_ah.png')}
                        <p><img src="{$baseUri}/images/menu/{$presenter->getParameter('id')}_ah.png?{rand(0,400)}"
                                class="img-responsive"></p>
                        <div><form action="{link deleteImage!, identifier => $presenter->getParameter('id'), type => '_ah'}" method="post" style="display: inline;">
                            <input type="hidden" name="_csrf" value="{$presenter->getMutationToken()}">
                            <button type="submit" class="btn btn-danger btn-xs">Smazat</button>
                        </form></div>
                    {/if}
                </div>
            </div>

        </div>
    </div>
</div>
