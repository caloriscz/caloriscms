{if $member && $member->username == 'admin'}
    {var $admin = true}
{/if}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="admin-csrf" content="{$presenter->getMutationToken()}">

    <title>{block #titles}{/block} | Caloris Admin</title>

    <link rel="stylesheet" href="/css/back.css">
    <link rel="stylesheet" href="/elfinder/css/elfinder.min.css?v={$adminBundleVersion}">
    <style>
        /* The open File Manager gets jQuery UI's .ui-front (z-index 100), under the
           Summernote toolbar (500) and the fixed header (1020). Its own dialogs, context
           menu and notifications are its children, so they rise with it. Bootstrap's
           modal backdrop starts at 1040. */
        .dialogelfinder.ui-front { z-index: 1035; }
    </style>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.2.1/themes/default/style.min.css"/>
</head>
<body class="app header-fixed sidebar-fixed aside-menu-fixed aside-menu-hidden">
{if $signed != false}
    <header class="app-header navbar">
        <button class="navbar-toggler mobile-sidebar-toggler d-lg-none" type="button">☰</button>
        <a class="navbar-brand" href="/"></a>
        <ul class="nav navbar-nav d-md-down-none">
            <li class="nav-item">
                <a class="nav-link navbar-toggler sidebar-toggler" href="#">☰</a>
            </li>
            <li class="nav-item px-3">
                <a class="nav-link" href="#">Dashboard</a>
            </li>
            <li class="nav-item px-3">
                <a class="nav-link" href="#">Settings</a>
            </li>
        </ul>
        <ul class="nav navbar-nav ml-auto">
            <li class="nav-item dropdown d-md-down-none">
                <a class="nav-link dropdown-toggle mr-5" data-toggle="dropdown" href="#" role="button"
                   aria-haspopup="true"
                   aria-expanded="false">
                    <span class="d-md-down-none">{if $member}{$member->username}{/if}</span>
                </a>
                <div class="dropdown-menu dropdown-menu-right">
                    <div class="dropdown-header text-center">
                        <strong>Nastavení</strong>
                    </div>

                    <form action="{link :Admin:Sign:out, id => NULL}" method="post">
                        <input type="hidden" name="_csrf" value="{$presenter->getMutationToken()}">
                        <button class="dropdown-item" type="submit">Odhlásit</button>
                    </form>
                    <a class="dropdown-item" n:href=":Admin:Profile:default, id => NULL">Můj profil</a>
                    <a class="dropdown-item" n:href=":Admin:Profile:default, id => NULL">Navštívit web</a>
                </div>
            </li>
        </ul>
    </header>
{/if}

{if $signed != false}
<div class="app-body">

    <div class="sidebar">
        <nav class="sidebar-nav">
            <nav class="sidebar-nav open" id="docsNavbarContent">
                <ul class="nav">
                    {control mainMenu}
                </ul>
            </nav>
        </nav>
    </div>
    <main class="main">
        {foreach $flashes as $flash}
            {if $iterator->first}
                <div class="text-center mt-3 mb-3">
            {/if}
            <div class="flash {$flash->type}">{$flash->message}</div>
            {if $iterator->last}
                </div>
            {/if}
        {/foreach}

        {include content}
    </main>
</div>
{else}
<body class="app flex-row align-items-center">
<div class="container">
    <div class="row justify-content-center">
        {include content}
    </div>
</div>
{/if}

{if $signed != false}
    <footer class="app-footer">
        <a href="http://caloris.cz">Caloris</a> © {date('Y')} Caloris.
        <span class="float-right">Powered by <a href="http://coreui.io">CoreUI</a>
        </span>
    </footer>
{/if}

<!-- Bootstrap and necessary plugins -->
<script src="/js/all-back.js?v={$adminBundleVersion}"></script>
<script src="/js/summernote-ext-elfinder.js"></script>
<script src="/js/ace/src-min-noconflict/ace.js"></script>

<script src="/js/app.js"></script>
<script src="/js/caloris-admin.js?v={$adminScriptVersion}"></script>


<script>
    function elfinderDialog() {
        var fm = $('<div/>').dialogelfinder({
            url: '/admin?do=elfinder-options&path=' + {$presenter->getParameter('id')},
            requestType: 'post',
            customHeaders: { 'X-CSRF-Token': $('meta[name="admin-csrf"]').attr('content') },
            lang: 'cs',
            baseUrl: '/elfinder/',
            uiOptions: {
                toolbar: [
                    ['view']
                ],
            },
            contextmenu: {
                navbar: ['info']
            },
            startPath: '/images',
            width: 840,
            // Taller than the window, the dialog is dragged up out of view
            // (draggable containment: 'window'), title bar and close button too.
            height: Math.min(850, $(window).height() - 20),
            destroyOnClose: true,
            // Selects the XHR upload transport. The iframe transport cannot send
            // the CMS or connector token headers, so both guards reject it.
            dragUploadAllow: true,
            getFileCallback: function (files, fm) {
                $('.summernote').summernote('editor.insertImage', files.url);
            },
            commandsOptions: {
                getfile: {
                    oncomplete: 'close',
                    folders: false
                }
            },
            handlers: {
                open: function (e, instance) {
                    // The 2.1.70 client already stores the connector token from
                    // the init open response; keep this as a harmless fallback.
                    if (typeof e.data.csrf === 'string') {
                        instance.customHeaders['X-elFinder-CSRF'] = e.data.csrf;
                    }
                },
                upload: function (e, instance) {
                }
            }

        }).dialogelfinder('instance');
    }
</script>

</body>
</html>
