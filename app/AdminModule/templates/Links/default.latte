{block #titles}Odkazy{/block}
{block content}

<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
    <li class="breadcrumb-item active">Odkazy</li>
</ol>


<div class="container-fluid">
    <div class="animated fadeIn">
        <div class="row">
            <div class="col-lg-3">
                <div class="card">
                    <div class="card-header">Kategorie odkazů</div>
                    <div class="card-block">
                        {control categoryPanel $categoryId}
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">Nový odkaz</div>
                    <div class="card-block">
                        <div>{control insertForm}</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="card">
                    <div class="card-header">Seznam odkazů</div>
                    <div class="card-block">
                        <table class="table table-striped">
                            <tr>
                                <th>Titulek</th>
                                <th>Kategorie</th>
                            </tr>
                            {foreach $links as $item}
                                <tr>
                                    <td>
                                        <form action="{link delete!, id => $item->id}" method="post" style="display: inline;" onsubmit="return confirm('Opravdu smazat odkaz?')">
                                            <input type="hidden" name="_csrf" value="{$presenter->getMutationToken()}">
                                            <button type="submit" class="btn">
                                            <i class="fa fa-times text-danger"></i>
                                        </button>
                                        </form>&nbsp;
                                        <a n:href=":Admin:Links:detail id => $item->id">
                                            {if $item->title}{$item->title}{else}<em>nemá jméno</em>{/if}
                                        </a>
                                    </td>
                                    <td>{$item->links_categories ? $item->links_categories->title : ''}</td>
                                </tr>
                            {/foreach}
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
