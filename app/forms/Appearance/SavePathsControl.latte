<form n:name="editForm" class="form-horizontal" role="form">
    {* One form is rendered per setting; show errors under the submitted one only. *}
    <div n:if="$form->hasErrors() && (string) $form['path_id']->getValue() === (string) $item->id" class="alert alert-danger">
        {foreach $form->getErrors() as $error}{$error} {/foreach}
    </div>
    <div class="row">
        <div class="col-sm-2">
            {if file_exists($appDir . '/images/paths/' . $item->setvalue)}
                <img src="/images/paths/{$item->setvalue}" alt="{$item->setvalue}" title="{$item->setvalue}"
                     class="img-responsive">
            {else}
                <p>Nenalezen</p>
            {/if}
        </div>
        <div class="col-sm-6">

            {if $item->type == 'local_path'}
                <p><strong>{$item->description_cs}</strong></p>
                <input type="hidden" n:name="path_id" value="{$item->id}">
                <input type="file" n:name="path">
                <br>
            {/if}
        </div>
        <div class="col-sm-4">
            <button type="submit" class="btn btn-success">Uložit</button>
        </div>
    </div>
</form>