<table class="table table-striped">
    {foreach $contacts as $contact}
        <tr>
            <td>
                <form action="{link delete!, id => $contact->id}" method="post" style="display: inline;" onsubmit="return confirm('Opravdu smazat?')">
                    <input type="hidden" name="_csrf" value="{$presenter->getMutationToken()}">
                    <button type="submit" class="btn btn-link text-danger">
                    <i class="fa fa-times font-red"></i>
                </button>
                </form>
            </td>
            <td><a href="{plink ':Admin:Contacts:detail', id => $contact->id}">{$contact->name}</a></td>
            <td>{$contact->contacts_categories->title ?? ''}</td>
            <td>{$contact->email}</td>
            <td>{$contact->phone}</td>
            <td>{$contact->vatin}</td>
        </tr>
    {/foreach}
</table>

<div class="text-center">
    {control paging, $args, $paginator}
</div>
