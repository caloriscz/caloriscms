<table class="table table-striped">
    <tr>
        <th></th>
        <th>uživatel</th>
        <th>role</th>
        <th>jméno</th>
        <th>stav</th>
    </tr>
    {foreach $userList as $item}
        <tr>
            <td class="w-5">
                <form action="{link delete!, id => $item->id}" method="post" style="display: inline;" onsubmit="return confirm('Opravdu smazat?')">
                    <input type="hidden" name="_csrf" value="{$presenter->getMutationToken()}">
                    <button type="submit" class="btn btn-link text-danger">
                    <i class="fa fa-times font-red"></i>
                </button>
                </form>
            </td>
            <td><a href="{plink ':Admin:Members:edit', id => $item->id}">{$item->username}</a></td>
            <td>{var $role = $item->ref('users_roles', 'users_roles_id')}{if $role}{$role->title}{/if}</td>
            <td>{$item->name}</td>
            <td>{$item->state}</td>
        </tr>
    {/foreach}
</table>

<div class="text-center">
    {control paging, $args, $paginator}
</div>
